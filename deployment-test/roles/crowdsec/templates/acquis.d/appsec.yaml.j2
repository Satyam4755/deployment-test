# AppSec listener acquisition.
# The listener address and config are mandatory: without them CrowdSec never
# opens 7422, and the Traefik bouncer (fail-closed) returns 403 for every
# request. The values come from roles/crowdsec/defaults.
source: appsec
listen_addr: {{ crowdsec_appsec_listen }}
appsec_config: {{ crowdsec_appsec_config }}
labels:
  type: appsec
