services:
  mariadb:
    image: {{ mariadb_image | default('mariadb:11.8') }}
    container_name: mariadb-database
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      start_period: 5s
      interval: 5s
      timeout: 5s
      retries: 5
    security_opt:
      - no-new-privileges:true
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    tmpfs:
      - /etc/mysql/encryption:rw
    env_file:
      - .env
    environment:
      MARIADB_AUTO_UPGRADE: 1
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/db_root_password
    command: |
      bash -c '
      mkdir -p /etc/mysql/encryption
      printf "1;%s\n" "$$(printf "%s" "$$DB_ENCRYPTION_KEY" | base64 -d | od -An -v -tx1 | tr -d " \n")" > /etc/mysql/encryption/keyfile
      echo "$$DB_KEY_PASSWORD" > /etc/mysql/encryption/keyfile.key
      openssl enc -aes-256-cbc -md sha1 -pass file:/etc/mysql/encryption/keyfile.key \
        -in /etc/mysql/encryption/keyfile \
        -out /etc/mysql/encryption/keyfile.enc
      exec docker-entrypoint.sh mariadbd \
        --character-set-server=utf8mb4 \
        --collation-server=utf8mb4_unicode_ci \
        --skip-character-set-client-handshake \
        --skip-innodb-read-only-compressed \
        --plugin-load-add=file_key_management \
        --file-key-management-filename=/etc/mysql/encryption/keyfile.enc \
        --file-key-management-filekey=FILE:/etc/mysql/encryption/keyfile.key \
        --innodb-encrypt-tables=ON \
        --innodb-encrypt-log=ON \
        --innodb-encryption-threads=4 \
        --encrypt-tmp-disk-tables=ON \
        --encrypt-tmp-files=ON \
        --innodb-buffer-pool-size=1G \
        --skip-symbolic-links
      '
    volumes:
      - mariadb-data:/var/lib/mysql:rw
    secrets:
      - db_root_password # /run/secrets/db_root_password, mounted 0444 by the engine
    networks:
      - erp-db

secrets:
  db_root_password:
    file: ./secrets/db_root_password

networks:
  erp-db:
    name: erp-db
    external: true

volumes:
  mariadb-data: