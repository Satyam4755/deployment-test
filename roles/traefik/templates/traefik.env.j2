# Traefik runtime env; templated by ansible to {{ base_dir }}/traefik/.env ; never commit real values
CF_DNS_API_TOKEN={{ cf_token | default('') }} # Cloudflare scoped DNS token for LE DNS-01; only set in Cloudflare modes
TRAEFIK_DASHBOARD_HOST={{ traefik_dashboard_host }} # FQDN for dashboard router Host() rule
TRAEFIK_CERT_RESOLVER={{ traefik_cert_resolver }} # must be `http` or `cloudflare` to match static certificatesResolvers keys
TRAEFIK_DASHBOARD_USERS_FILE=/run/secrets/dashboard_users # per-admin basic auth from Compose secret
TZ={{ tz | default('UTC') }} # IANA timezone for log timestamps
