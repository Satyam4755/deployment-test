# CrowdSec container environment; templated by ansible to {{ base_dir }}/crowdsec/.env
# The container runs as root, the upstream image default. UID/GID are
# deliberately not set: dropping to 1000 cannot write the root-owned named
# volumes or read /var/log/auth.log.

# Collections to install on container start. The image installs these every
# time it starts. The value is space-separated, which is what the image
# expects; a JSON list becomes invalid collection names.
COLLECTIONS={{ crowdsec_collections | join(' ') }}

# Local API client destination URL
# Configures local_api_credentials.yaml so cscli and internal agent dial 127.0.0.1:8080
# rather than attempting 0.0.0.0:8080.
LOCAL_API_URL={{ crowdsec_lapi_url | default('http://127.0.0.1:8080') }}

# The LAPI bouncer keys and Telegram credentials are deliberately NOT here.
# Keys are registered with the LAPI by roles/crowdsec/tasks/main.yml and
# reach enforcers through their rendered configs. Telegram config lives in
# telegram.yaml. Keeping them out of the container environment keeps them out
# of `docker inspect` output.
