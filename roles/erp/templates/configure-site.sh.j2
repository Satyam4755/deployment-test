#!/bin/bash
# Initial site configuration, run inside the one-shot configurator.
#
# The image's init-site.sh owns the app set when it is present. Otherwise this
# wrapper follows Frappe's documented `bench new-site` flow and installs
# frappe_site_apps. Either way it then fills the initial site-config keys that
# this deployment owns (logger, public host and outgoing mail). A key is
# written only when it is absent, so a later operator change is never
# overwritten on a re-run.
#
# Secrets are read from the Compose secret files. They are never passed as
# arguments except the root password, which Frappe requires for `bench
# new-site`; it is removed from the shell as soon as the site exists.

set -euo pipefail

SITE_CONFIG="/home/frappe/frappe-bench/sites/${SITE_NAME}/site_config.json"

export DB_ROOT_PASSWORD="$(cat /run/secrets/db_root_password)"

if [[ -x /docker/scripts/init-site.sh ]]; then
    /docker/scripts/init-site.sh
else
    # The image does not ship an init script. Create the site only when it is
    # absent; a re-run must not attempt `bench new-site` again.
    if [[ ! -f "$SITE_CONFIG" ]]; then
        install_args=()
        for app in ${FRAPPE_SITE_APPS:-}; do
            install_args+=(--install-app "$app")
        done
        bench new-site "$SITE_NAME" \
            --mariadb-user-host-login-scope='172.30.%.%' \
            --db-root-password "$DB_ROOT_PASSWORD" \
            --admin-password "$ADMIN_PASSWORD" \
            "${install_args[@]}"
    fi
fi

unset DB_ROOT_PASSWORD

python3 - <<'PY'
import json
import os

site = os.environ["SITE_NAME"]
path = f"/home/frappe/frappe-bench/sites/{site}/site_config.json"

with open(path) as handle:
    config = json.load(handle)


def enabled(name):
    return os.environ.get(name, "0") == "1"


defaults = {
    "enable_frappe_logger": 1 if enabled("FRAPPE_ENABLE_LOGGER") else 0,
    "host_name": os.environ["FRAPPE_HOST_NAME"],
}

if enabled("FRAPPE_EMAIL_ENABLED"):
    with open("/run/secrets/mail_password") as handle:
        mail_password = handle.read().strip()
    login = os.environ["FRAPPE_MAIL_LOGIN"]
    defaults.update(
        {
            "mail_server": os.environ["FRAPPE_MAIL_SERVER"],
            "mail_port": int(os.environ["FRAPPE_MAIL_PORT"]),
            "mail_login": login,
            "mail_password": mail_password,
            "use_ssl": enabled("FRAPPE_MAIL_USE_SSL"),
            "use_tls": enabled("FRAPPE_MAIL_USE_TLS"),
            "auto_email_id": os.environ.get("FRAPPE_AUTO_EMAIL_ID") or login,
            "email_sender_name": os.environ["FRAPPE_EMAIL_SENDER_NAME"],
        }
    )

changed = False
for key, value in defaults.items():
    if key not in config:
        config[key] = value
        changed = True

# Fail closed before the backend starts. A site without its database identity
# is unusable, and an enabled mail path without every value is a half-written
# configuration.
required = ["db_name", "db_password"]
if enabled("FRAPPE_EMAIL_ENABLED"):
    required += ["mail_server", "mail_port", "mail_login", "mail_password"]
missing = [key for key in required if not config.get(key)]
if missing:
    raise SystemExit(
        f"site_config.json for {site} is missing required values: {', '.join(missing)}"
    )

if enabled("FRAPPE_EMAIL_ENABLED") and config.get("use_ssl") == config.get("use_tls"):
    raise SystemExit(
        "site_config.json must enable exactly one of use_ssl and use_tls"
    )

if changed:
    with open(path, "w") as handle:
        json.dump(config, handle, indent=1, sort_keys=True)
        handle.write("\n")
PY

# Verify that Frappe can connect to the database with the site's own credentials
echo "Verifying Frappe database connectivity for ${SITE_NAME}..."
bench --site "$SITE_NAME" mariadb -e "SELECT 1;" >/dev/null
echo "Database connectivity confirmed for ${SITE_NAME}."
